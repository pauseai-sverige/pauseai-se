---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { url } from '../lib'

interface Props {
	title?: string
	description?: string
	/** false on pages without an address of their own, like the 404 page. */
	canonical?: boolean
}

const siteName = 'PauseAI Sverige'
const {
	title,
	description = 'Vi vill pausa utvecklingen av de mest kraftfulla AI-systemen tills vi vet hur de kan göras säkra.',
	canonical = true
} = Astro.props
const fullTitle = title ? `${title} | ${siteName}` : siteName
// Without a query string, so that shared links with ?fbclid=… count as the same page.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href
---

<!doctype html>
<html lang="sv">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="sv_SE" />
		{canonical && <link rel="canonical" href={canonicalUrl} />}
		<link rel="icon" type="image/png" href={url('/favicon.png')} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;700&family=Saira+Condensed:wght@700&display=swap"
		/>
		<!-- Visitor count, without cookies or personal data: https://pauseai-se.goatcounter.com -->
		<script is:inline data-goatcounter="https://pauseai-se.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
	</head>
	<body>
		<a class="visually-hidden" href="#innehall">Hoppa till innehållet</a>
		<Header />
		<main id="innehall">
			<slot />
		</main>
		<Footer />
	</body>
</html>
