---
// Email tool: pick members of the Riksdag from your constituency, fill in a few
// details, and the email is composed in the browser. Nothing is stored or sent
// from here; the visitor sends it from their own email app.
import Base from '../layouts/Base.astro'
import { fetchLedamoter } from '../riksdagen'
import { url } from '../lib'

const ledamoter = await fetchLedamoter()
const unique = (values: string[]) => [...new Set(values)].sort((a, b) => a.localeCompare(b, 'sv'))
const valkretsar = unique(ledamoter.map((l) => l.valkrets))
const partier = unique(ledamoter.map((l) => l.parti))

// The claims in the email text are checked against their primary sources in Belagt,
// see docs/kallor.md. Each topic paragraph in the script below ends with its source.
// Incidenter: Belagt J3ljHm57yU0-18, Belagt MET-04
// Experter: Belagt TID-08, Belagt SVE-13
// Institut: Belagt SVE-01, Belagt SVE-02
---

<Base
	title="Mejla en riksdagsledamot"
	description="Skriv till riksdagsledamöterna från din valkrets om riskerna med AI. Mejlet skapas i din webbläsare och skickas från ditt eget mejlprogram."
>
	<article class="container prose">
		<h1>Mejla en riksdagsledamot</h1>
		<p class="lead">
			Riksdagens ledamöter behöver höra att väljare bryr sig om riskerna med AI. Välj vilka du vill skriva till, fyll i
			ditt namn och skicka. Det tar endast ett par minuter!
		</p>
		<p>
			Redigera gärna mailet för att ge det din egna personliga touch, så får du ännu bättre påverkan.
		</p>

		<form id="mejla" class="steps">
			<section class="step">
				<h2><span class="n">1</span> Vem vill du skriva till?</h2>
				{
					ledamoter.length > 0 ? (
						<>
							<p>
								Skriv gärna till ledamöterna från din egen valkrets, eftersom de företräder dig. Välj en eller ett par,
								så fastnar mejlet inte i skräppostfilter.
							</p>
							<div class="lista">
								<div class="filter">
									<p class="field">
										<label for="valkrets">Valkrets</label>
										<select id="valkrets" name="valkrets">
											<option value="">Alla valkretsar</option>
											{valkretsar.map((v) => <option value={v}>{v}</option>)}
										</select>
									</p>
									<p class="field">
										<label for="parti">Parti</label>
										<select id="parti" name="parti">
											<option value="">Alla partier</option>
											{partier.map((p) => <option value={p}>{p}</option>)}
										</select>
									</p>
								</div>
								<ul class="ledamoter" id="ledamoter">
									{ledamoter.map((l) => (
										<li data-valkrets={l.valkrets} data-parti={l.parti}>
											<label>
												<input
													type="checkbox"
													name="till"
													value={l.epost}
													data-fornamn={l.fornamn}
													data-namn={`${l.fornamn} ${l.efternamn}`}
													data-parti={l.parti}
													data-valkrets={l.valkrets}
													data-bild={l.bild}
												/>
												<img src={l.bild} alt="" width="40" height="40" loading="lazy" />
												<span>
													<strong>
														{l.fornamn} {l.efternamn}
													</strong>
													<span class="muted">
														{l.parti} · {l.valkrets}
													</span>
												</span>
											</label>
										</li>
									))}
								</ul>
								<p class="muted small" id="tom" hidden>Ingen ledamot matchar filtret.</p>
								<p class="lista-fot">
									<span class="muted small" id="antal">{ledamoter.length} ledamöter</span>
									<button class="button secondary small" type="button" id="fler" hidden></button>
								</p>
							</div>
							<p class="muted small">
								Namn, parti och mejladresser kommer från{' '}
								<a href="https://www.riksdagen.se/sv/ledamoter-och-partier/">riksdagen.se</a> och hämtas varje natt.
							</p>
						</>
					) : (
						<p>
							Alla ledamöter finns på <a href="https://www.riksdagen.se/sv/ledamoter-och-partier/">riksdagen.se</a>,
							där du kan sortera på valkrets och parti. Kopiera mejladressen därifrån.
						</p>
					)
				}
			</section>

			<section class="step">
				<h2><span class="n">2</span> Om dig</h2>
				<div class="fields">
					<p class="field">
						<label for="namn">Ditt namn</label>
						<input id="namn" name="namn" type="text" autocomplete="name" required />
					</p>
					<p class="field">
						<label for="ort">Ort <span class="muted">(valfritt)</span></label>
						<input id="ort" name="ort" type="text" autocomplete="address-level2" />
					</p>
					<p class="field full">
						<label for="bakgrund">Kort om dig <span class="muted">(valfritt, t.ex. "lärare och småbarnsförälder")</span></label>
						<input id="bakgrund" name="bakgrund" type="text" />
					</p>
					<p class="field full">
						<label for="varfor">Varför bryr du dig? <span class="muted">(valfritt, en mening räcker)</span></label>
						<textarea id="varfor" name="varfor" rows="2"></textarea>
					</p>
				</div>
				<fieldset class="amnen">
					<legend>Vad vill du lyfta? <span class="muted">(välj gärna ett eller två)</span></legend>
					<label><input type="checkbox" name="amnen" value="incidenter" /> Incidenter som har hänt</label>
					<label><input type="checkbox" name="amnen" value="experter" /> Experter varnar</label>
					<label><input type="checkbox" name="amnen" value="institut" /> AI-säkerhetsinstitut</label>
				</fieldset>
				<p class="muted small">
					Inget du skriver sparas eller skickas någonstans. Mejlet skapas här i din webbläsare och skickas från ditt
					eget mejlprogram.
				</p>
			</section>

			<section class="step">
				<h2><span class="n">3</span> Ditt mejl</h2>
				<p>Ändra gärna i texten och skriv med egna ord. Mejlet går till de ledamöter du har kryssat i.</p>
				<div class="till">
					<span class="till-label">Till:</span>
					<ul id="mottagare" aria-label="Mottagare"></ul>
					<span class="muted small" id="ingen">Ingen vald ännu. Välj ledamöter under steg 1.</span>
				</div>
				<!-- Cloned by the script for each chosen member; a template keeps the scoped styles. -->
				<template id="chip">
					<li class="chip">
						<img alt="" width="28" height="28" />
						<span></span>
						<button type="button">×</button>
					</li>
				</template>
				<p class="field">
					<label for="amne">Ämne</label>
					<input id="amne" name="amne" type="text" />
				</p>
				<p class="field">
					<span class="label" id="text-label">Mejlet</span>
					<div id="text" class="mail" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="text-label">
					</div>
				</p>
				<p class="actions">
					<a class="button" id="oppna" href="#">Öppna i mejlprogram</a>
					<button class="button secondary" type="button" id="kopiera">Kopiera mejlet</button>
					<button class="button secondary" type="button" id="kopiera-amne">Kopiera ämne</button>
					<button class="button secondary" type="button" id="kopiera-adresser">Kopiera adresser</button>
				</p>
				<p class="muted small" id="status" aria-live="polite"></p>
				<p class="muted small">
					Öppnas inget mejlprogram? Kopiera texten och adresserna och klistra in dem i ditt vanliga mejl.
				</p>
			</section>
		</form>

		<p>
			Mer om riskerna och vad Sverige kan göra finns under <a href={url('/forslaget')}>förslaget</a>. Verktyget är
			inspirerat av <a href="https://vimasteprataomai.nu/mejla/">Vi måste prata om AI</a>.
		</p>
	</article>
</Base>

<script>
	const pick = <T,>(items: T[]): T => items[Math.floor(Math.random() * items.length)]!
	const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T

	// Varied per visit so the emails do not look like a mass mailing.
	const SUBJECT = pick([
		'Några tankar om AI från en väljare',
		'Hur tänker du kring AI-utvecklingen?',
		'En fråga om AI och vår framtid',
		'Nyfiken på hur riksdagen ser på AI'
	])
	const INTRO = pick([
		'Jag skriver för att uttrycka min oro över hur snabbt AI utvecklas och vad det kan innebära för vårt samhälle.',
		'Jag hör av mig eftersom jag är orolig över utvecklingen av AI och hur den kan komma att påverka vårt samhälle.',
		'Jag vill lyfta en fråga som oroar mig: hur snabbt AI utvecklas, och vad det kan betyda för vårt samhälle.'
	])
	const ASK = pick([
		'Jag är nyfiken på hur du tänker kring AI-frågan, hur samtalet går i riksdagen och vilka utmaningar ni ställs inför.',
		'Jag är nyfiken på hur du och ditt parti ser på AI-frågan, och på hur den diskuteras i riksdagen i dag.',
		'Jag skulle gärna höra hur du tänker kring det här, och vad som krävs för att frågan ska komma högre upp på dagordningen.'
	])

	// Topic paragraphs with their primary sources, written as [text](url). Rendered as
	// real links in the preview and copied as rich text.
	// Belagt ids are in the frontmatter.
	const TOPICS: Record<string, string> = {
		incidenter:
			'Det som fick mig att ta frågan på allvar var att AI-modeller redan har brutit sig ur sina testmiljöer. I juli 2026 bröt sig OpenAI:s AI-agenter in hos Hugging Face utan att någon hade bett dem om det, [enligt OpenAI själva](https://openai.com/index/hugging-face-incident-and-the-road-ahead/). Agenterna förstod att det var fel men gjorde det ändå, enligt [en oberoende utredning](https://metr.org/blog/2026-08-26-openai-hugging-face-incident-investigation/).',
		experter:
			'Hundratals AI-forskare och företagsledare, bland dem Geoffrey Hinton och vd:arna för OpenAI och Anthropic, har skrivit under att utrotningsrisk från AI bör tas lika allvarligt som pandemier och kärnvapen, se [uttalandet om AI-risk](https://www.safe.ai/work/statement-on-ai-risk). I september 2026 skrev Anthropics vd att takten måste sänkas, med stöd av Sam Altman och Elon Musk, enligt [The Guardian](https://www.theguardian.com/technology/2026/sep/13/openai-sam-altman-elon-musk-back-anthropic-calls-brakes-ai-development).',
		institut:
			'Ett konkret steg är ett svenskt institut för AI-säkerhet som granskar de mest kraftfulla modellerna, som [AI-kommissionen föreslog 2024](https://www.riksdagen.se/sv/dokument-och-lagar/dokument/statens-offentliga-utredningar/ai-kommissionens-fardplan-for-sverige_hdb312/html/). [Centerpartiet driver redan förslaget](https://www.centerpartiet.se/centerpartiets-politik/centerpartiets-politik-a-o/digitalisering/artificiell-intelligens-ai).'
	}

	const form = byId<HTMLFormElement>('mejla')
	const valkrets = document.getElementById('valkrets') as HTMLSelectElement | null
	const parti = document.getElementById('parti') as HTMLSelectElement | null
	const list = document.getElementById('ledamoter')
	const amne = byId<HTMLInputElement>('amne')
	const text = byId<HTMLDivElement>('text')
	const oppna = byId<HTMLAnchorElement>('oppna')
	const status = byId('status')
	let edited = false

	const clean = (s: string) => s.replace(/\s+/g, ' ').trim()
	const sentence = (s: string) => {
		s = clean(s)
		if (!s) return ''
		s = s.charAt(0).toUpperCase() + s.slice(1)
		return /[.!?…]$/.test(s) ? s : s + '.'
	}

	const chosen = () => [...form.querySelectorAll<HTMLInputElement>('input[name="till"]:checked')]
	const unique = (values: string[]) => [...new Set(values)]

	function compose(): string {
		const to = chosen()
		const namn = clean(byId<HTMLInputElement>('namn').value) || '[Ditt namn]'
		const ort = clean(byId<HTMLInputElement>('ort').value)
		const varfor = sentence(byId<HTMLTextAreaElement>('varfor').value)
		const bakgrund = clean(byId<HTMLInputElement>('bakgrund').value).replace(/\.$/, '')
		const topics = [...form.querySelectorAll<HTMLInputElement>('input[name="amnen"]:checked')].map((c) => TOPICS[c.value])
		// Mention the constituency only when everyone chosen represents the same one.
		const kretsar = unique(to.map((c) => c.dataset.valkrets ?? ''))
		const krets = kretsar.length === 1 ? kretsar[0] : ''

		// "Jag heter Kim, är lärare och bor i Umeå."
		const about = [bakgrund ? `är ${bakgrund}` : '', ort ? `bor i ${ort}` : ''].filter(Boolean)
		const presentation = about.length ? `Jag heter ${namn}, ${about.join(' och ')}.` : `Jag heter ${namn}.`
		const intro = [presentation, krets ? `Jag skriver till dig som ledamot för ${krets}.` : '', INTRO, varfor]

		return [
			to.length === 1 ? `Hej ${to[0]!.dataset.fornamn}!` : 'Hej!',
			intro.filter(Boolean).join(' '),
			...topics,
			'Internationellt lyfts frågan allt mer, och jag tycker att Sverige borde vara med och driva på. Mer om vad Sverige kan göra finns hos [PauseAI Sverige](https://pauseai.se/forslaget).',
			`${ASK} Svara gärna, även kort.`,
			`Vänliga hälsningar,\n\n${namn}${ort ? '\n' + ort : ''}`
		].join('\n\n')
	}

	function render() {
		if (!edited) {
			amne.value = SUBJECT
			text.innerHTML = toHtml(compose())
		}
		const addresses = chosen().map((c) => c.value)
		oppna.href = `mailto:${addresses.join(',')}?subject=${encodeURIComponent(amne.value)}&body=${encodeURIComponent(toPlain(text).replace(/\n/g, '\r\n'))}`
		renderRecipients()
	}

	// Chips in step 3 showing who the email goes to.
	const mottagare = byId<HTMLUListElement>('mottagare')
	const ingen = byId('ingen')
	const chip = byId<HTMLTemplateElement>('chip')
	function renderRecipients() {
		const to = chosen()
		mottagare.replaceChildren(
			...to.map((c) => {
				const li = (chip.content.cloneNode(true) as DocumentFragment).firstElementChild as HTMLLIElement
				li.querySelector('img')!.src = c.dataset.bild ?? ''
				li.querySelector('span')!.textContent = `${c.dataset.namn} (${c.dataset.parti})`
				const remove = li.querySelector('button')!
				remove.setAttribute('aria-label', `Ta bort ${c.dataset.namn}`)
				remove.addEventListener('click', () => {
					c.checked = false
					render()
					filter()
				})
				return li
			})
		)
		ingen.hidden = to.length > 0
	}

	// Filter the list by constituency and party. Choices survive filtering; the chips in
	// step 3 show them and can remove them.
	// Only the first few matches are shown until the visitor asks for more.
	const LIMIT = 12
	let expanded = false
	const fler = document.getElementById('fler') as HTMLButtonElement | null
	function filter() {
		let matching = 0
		list?.querySelectorAll<HTMLLIElement>('li').forEach((li) => {
			const match =
				(!valkrets?.value || li.dataset.valkrets === valkrets.value) && (!parti?.value || li.dataset.parti === parti.value)
			if (match) matching++
			li.hidden = !match || (!expanded && matching > LIMIT)
		})
		const tom = document.getElementById('tom')
		if (tom) tom.hidden = matching > 0
		const antal = document.getElementById('antal')
		const valda = chosen().length
		if (antal) antal.textContent = `${matching} ledamöter` + (valda ? ` · ${valda} valda` : '')
		// Fade the bottom of the list while more members are hidden.
		list?.toggleAttribute('data-avklippt', !expanded && matching > LIMIT)
		if (fler) {
			fler.hidden = matching <= LIMIT
			fler.textContent = expanded ? 'Visa färre' : `Visa alla (${matching})`
			fler.setAttribute('aria-expanded', String(expanded))
		}
	}
	fler?.addEventListener('click', () => {
		expanded = !expanded
		filter()
	})
	const refilter = () => {
		expanded = false
		filter()
	}
	valkrets?.addEventListener('change', refilter)
	parti?.addEventListener('change', refilter)
	filter()
	form.addEventListener('change', (event) => {
		if ((event.target as HTMLInputElement).name === 'till') filter()
	})

	form.addEventListener('input', (event) => {
		const target = event.target as HTMLElement
		// Once the visitor edits the email itself, stop regenerating it.
		if (target === amne || target === text) edited = true
		render()
	})
	form.addEventListener('submit', (event) => event.preventDefault())

	const escape = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!)

	// The composed text uses [text](url) for links. Rendered as paragraphs with real links
	// in the editable preview, and the same HTML goes to the clipboard.
	function toHtml(source: string): string {
		return source
			.split(/\n\n/)
			.map((p) => {
				const html = escape(p)
					.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2">$1</a>')
					.replace(/\n/g, '<br>')
				return `<p>${html}</p>`
			})
			.join('')
	}

	// Plain text for the mailto link: links become "text (url)", blocks become paragraphs.
	// Browsers insert <p>, <div> or <br> when the visitor presses Enter, so all are handled.
	function toPlain(root: HTMLElement): string {
		const blocks: string[] = []
		const inline = (node: Node): string => {
			if (node.nodeType === Node.TEXT_NODE) return node.textContent ?? ''
			if (!(node instanceof HTMLElement)) return ''
			if (node.tagName === 'BR') return '\n'
			if (node.tagName === 'A') return `${node.textContent} (${node.getAttribute('href')})`
			return [...node.childNodes].map(inline).join('')
		}
		for (const node of root.childNodes) {
			if (node instanceof HTMLElement && /^(P|DIV)$/.test(node.tagName)) blocks.push(inline(node))
			else if (blocks.length) blocks[blocks.length - 1] += inline(node)
			else blocks.push(inline(node))
		}
		return blocks
			.map((b) => b.replace(/ /g, ' ').trim())
			.filter(Boolean)
			.join('\n\n')
	}

	async function copy(value: string, message: string, html?: string) {
		try {
			if (html && typeof ClipboardItem !== 'undefined') {
				await navigator.clipboard.write([
					new ClipboardItem({
						'text/plain': new Blob([value], { type: 'text/plain' }),
						'text/html': new Blob([html], { type: 'text/html' })
					})
				])
			} else await navigator.clipboard.writeText(value)
			status.textContent = message
		} catch {
			const range = document.createRange()
			range.selectNodeContents(text)
			getSelection()?.removeAllRanges()
			getSelection()?.addRange(range)
			status.textContent = 'Kunde inte kopiera. Texten är markerad, kopiera den med Ctrl+C eller Cmd+C.'
		}
	}
	byId('kopiera').addEventListener('click', () =>
		copy(toPlain(text), 'Mejlet är kopierat. Klistra in det i ditt mejlprogram, så följer länkarna med.', text.innerHTML)
	)
	byId('kopiera-amne').addEventListener('click', () => copy(amne.value, 'Ämnesraden är kopierad.'))
	byId('kopiera-adresser').addEventListener('click', () => {
		const addresses = chosen().map((c) => c.value)
		if (addresses.length) copy(addresses.join(', '), 'Adresserna är kopierade.')
		else status.textContent = 'Välj minst en ledamot under steg 1.'
	})

	render()
</script>

<style>
	.lead {
		font-size: 1.15rem;
	}
	.steps {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-top: 2rem;
	}
	.step {
		padding: 1.5rem;
		border-top: 6px solid var(--brand);
		background: var(--bg-alt);
	}
	.step h2 {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 0;
	}
	.n {
		display: grid;
		place-items: center;
		width: 2.2rem;
		height: 2.2rem;
		padding-top: 0.15em;
		border-radius: 50%;
		background: var(--brand);
		color: #000;
		font-size: 1.4rem;
		line-height: 1;
	}
	.amnen {
		margin: 0.5rem 0 1rem;
		padding: 0;
		border: 0;
	}
	.amnen legend {
		padding: 0;
		margin-bottom: 0.4rem;
		font-family: var(--font-heading);
		font-size: 1.15rem;
		text-transform: uppercase;
	}
	.amnen label {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0 0.5rem 0.5rem 0;
		padding: 0.4rem 0.8rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--bg);
		cursor: pointer;
	}
	.amnen label:has(:checked) {
		border-color: var(--brand);
		box-shadow: inset 0 0 0 1px var(--brand);
	}
	.amnen input {
		width: auto;
		margin: 0;
	}
	.fields {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 0 1.5rem;
	}
	.full {
		grid-column: 1 / -1;
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}
	.field label {
		font-family: var(--font-heading);
		font-size: 1.15rem;
		text-transform: uppercase;
	}
	input,
	select,
	textarea {
		width: 100%;
		padding: 0.5rem 0.7rem;
		border: 1px solid var(--border);
		border-radius: 4px;
		background: var(--bg);
		color: var(--text);
		font: inherit;
		font-size: 1rem;
	}
	textarea {
		resize: vertical;
	}
	.label {
		font-family: var(--font-heading);
		font-size: 1.15rem;
		text-transform: uppercase;
	}
	.mail {
		min-height: 20rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--border);
		border-radius: 4px;
		background: var(--bg);
		font-size: 1rem;
