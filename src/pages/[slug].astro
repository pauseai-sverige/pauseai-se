---
import { getCollection, render } from 'astro:content'
import Base from '../layouts/Base.astro'
import { url } from '../lib'

export async function getStaticPaths() {
	const sidor = await getCollection('sidor')
	// Sidor som har en egen .astro-fil hoppas över här.
	return sidor.filter((sida) => !['engagera-dig', 'upprop'].includes(sida.id)).map((sida) => ({ params: { slug: sida.id }, props: { sida } }))
}

const { sida } = Astro.props
const { Content } = await render(sida)
const { knapp_text, knapp_lank } = sida.data
// Interna länkar (/donera) får base framför, externa lämnas som de är.
const knappHref = knapp_lank?.startsWith('/') ? url(knapp_lank) : knapp_lank
---

<Base title={sida.data.title} description={sida.data.description}>
	<article class:list={[sida.data.sidokolumn ? 'container-wide' : 'container', 'prose']}>
		<h1>{sida.data.title}</h1>
		{knapp_text && knappHref && <p><a class="button" href={knappHref}>{knapp_text}</a></p>}
		<Content />
	</article>
	{
		sida.data.fallbara && (
			<script is:inline>
				{
					const all = () => [...document.querySelectorAll('.prose details')]

					// Öppna det hopfällda avsnittet som en länk med #rubrik pekar på.
					const openHash = () =>
						document.getElementById(decodeURIComponent(location.hash.slice(1)))?.closest('details')?.setAttribute('open', '')
					openHash()
					addEventListener('hashchange', openHash)

					// Knapp som fäller ut eller ihop allt, före första fällbara avsnittet.
					const first = document.querySelector('.prose .kolumner, .prose .fallbar')
					if (first) {
						const button = document.createElement('button')
						button.type = 'button'
						button.className = 'button secondary visa-allt'
						const update = () => {
							const allOpen = all().every((d) => d.open)
							button.textContent = allOpen ? 'Fäll ihop allt' : 'Visa allt'
							button.setAttribute('aria-pressed', String(allOpen))
						}
						button.addEventListener('click', () => {
							const open = !all().every((d) => d.open)
							all().forEach((d) => (d.open = open))
						})
						document.addEventListener('toggle', update, true)
						update()
						first.before(button)
					}

					// Skriv ut allt, och fäll sedan ihop det som var hopfällt.
					let closed = []
					addEventListener('beforeprint', () => {
						closed = all().filter((d) => !d.open)
						closed.forEach((d) => (d.open = true))
					})
					addEventListener('afterprint', () => closed.forEach((d) => (d.open = false)))
				}
			</script>
		)
	}
</Base>
