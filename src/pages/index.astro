---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import EventList from '../components/EventList.astro'
import InsatsList from '../components/InsatsList.astro'
import OnboardingEmbed from '../components/OnboardingEmbed.astro'
import StoryCard from '../components/StoryCard.astro'
import { formatDate, imageUrl, isUpcoming, url } from '../lib'

const upcoming = (await getCollection('evenemang'))
	.filter((e) => isUpcoming(e.data.date))
	.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
	.slice(0, 3)
const posts = (await getCollection('blogg')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3)
const insatser = (await getCollection('insatser')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3)
const stories = (await getCollection('berattelser')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const contacts = stories.filter((s) => s.data.kontaktperson)

const sections = [
	{
		title: 'Vi behöver en <u>paus</u>',
		text: 'Stoppa träningen av de mest kraftfulla generella AI-systemen tills vi vet hur de kan göras säkra. Det måste ske internationellt, och det måste ske snart.',
		cta: 'Läs förslaget',
		href: '/forslaget'
	},
	{
		title: 'Vi riskerar att <u>tappa kontrollen</u>',
		text: 'AI kan ge fantastiska fördelar, men kan också urholka vår demokrati, destabilisera vår ekonomi och användas för att skapa kraftfulla cybervapen.',
		cta: 'Läs om riskerna',
		href: '/risker'
	},
	{
		title: 'Vi riskerar <u>mänsklig utrotning</u>',
		text: 'Hundratals AI-forskare och cheferna för de ledande AI-företagen har skrivit under att risken för utrotning från AI bör tas lika allvarligt som pandemier och kärnvapenkrig.',
		cta: 'Hur och varför AI kan döda oss',
		href: '/existentiell-risk'
	}
]

// Händelser och citat är kontrollerade mot sina primärkällor i Belagt
// (pauseai-sverige.github.io/belagt, id vid varje post). Se över dem när posternas
// bäst före-datum har passerat.
const news2026 = [
	{
		when: 'September 2026',
		text: 'Anthropics vd skriver att takten i AI-utvecklingen måste sänkas. OpenAI:s Sam Altman och Elon Musk ställer sig bakom.',
		// Belagt SVE-13
		source: 'https://www.theguardian.com/technology/2026/sep/13/openai-sam-altman-elon-musk-back-anthropic-calls-brakes-ai-development#:~:text=Committing%20to%20having%20independent,will%20do%20the%20same'
	},
	{
		when: 'Augusti 2026',
		text: 'OpenAI pausar delar av träningen av sina senaste modeller efter intrånget. En del har sedan återupptagits under starkare kontroller.',
		// Belagt OAI-05
		source: 'https://openai.com/index/research-acceleration-view-inside-openai/#:~:text=pausing%20reinforcement%20learning%20%28RL%29,while%20others%20remained%20paused'
	},
	{
		when: 'Juli 2026',
		text: 'Under ett test tar sig OpenAI:s AI-agenter ut ur sin isolerade miljö och bryter sig in hos Hugging Face, utan att någon människa har bett dem om det.',
		// Belagt J3ljHm57yU0-18
		source: 'https://openai.com/index/hugging-face-incident-and-the-road-ahead/#:~:text=In%20July%202026%2C%20during,and%20compromised%20parts%20of'
	},
	{
		when: 'Juni 2026',
		text: 'Bara 10 procent av svenskarna tycker att AI är tillräckligt reglerat. 51 procent tycker att tillsynen är otillräcklig.',
		// Belagt SVR-14
		source: 'https://futurion.se/wp-content/uploads/2026/06/futurion-x-seismic-rapport-ai-2026-2-juni.pdf'
	}
]

const quotes = [
	{
		text: 'Jag tror i dag att inget labb har löst alignment och övervakning tillräckligt för att ansvarsfullt fortsätta skala upp i maxfart mycket längre.',
		author: 'Jakub Pachocki',
		title: 'Forskningschef på OpenAI, september 2026',
		// Belagt J3ljHm57yU0-12
		source: 'https://openai.com/index/an-alien-mind/#:~:text=Currently%20I%20believe%20that,speed%20for%20much%20longer'
	},
	{
		text: 'Framstegen vid fronten går snabbare än vår förståelse av tekniken.',
		author: 'Demis Hassabis',
		title: 'Vd för Google DeepMind och Nobelpristagare, september 2026',
		// Belagt J3ljHm57yU0-38
		source: 'https://demishassabis.substack.com/p/a-framework-for-frontier-ai-and-the-dawning-of-a-new-age#:~:text=advances%20on%20the%20frontier,understanding%20of%20the%20technology'
	},
	{
		text: 'Jag tror att det är 20 procent att det går åt skogen.',
		author: 'Pontus Johnson',
		title: 'Professor vid KTH, augusti 2026',
		// Belagt SVR-04
		source: 'https://www.gp.se/nyheter/sverige/larm-om-ai-rymningar-behover-bromsa-utvecklingen.92a94daa-df5f-5089-8eac-91560d6830c4#:~:text=Jag%20tror%20att%20det,det%20g%C3%A5r%20%C3%A5t%20skogen'
	}
]
---

<Base>
	<section class="hero">
		<div class="container-wide">
			<h1>Låt inte AI-bolag spela roulette med vår framtid</h1>
			<p class="lead">
				PauseAI Sverige vill att Sverige verkar för ett internationellt stopp för de mest kraftfulla AI-systemen,
				tills vi vet hur de kan göras säkra.
			</p>
			<p class="actions">
				<a class="button" href="#ga-med">Gå med</a>
				<a class="button secondary" href="#evenemang">Kommande evenemang ↓</a>
				<a class="button secondary" href={url('/vad-vi-har-gjort')}>Det vi har gjort →</a>
			</p>
		</div>
	</section>

	<section class="container-wide cards">
		{
			sections.map((s) => (
				<article class="card">
					<h2 set:html={s.title} />
					<p>{s.text}</p>
					<a href={url(s.href)}>{s.cta} →</a>
				</article>
			))
		}
	</section>

	<section class="container-wide now">
		<h2>Läget hösten 2026</h2>
		<p class="muted">Företagen som bygger AI säger nu själva att det går för fort.</p>
		<ol class="timeline">
			{
				news2026.map((n) => (
					<li>
						<strong>{n.when}</strong>
						<span>
							{n.text} <a href={n.source}>Källa</a>
						</span>
					</li>
				))
			}
		</ol>
	</section>

	<section class="quotes">
		<div class="container-wide quote-grid">
			{
				quotes.map((q) => (
					<figure>
						<blockquote>”{q.text}”</blockquote>
						<figcaption>
							<strong>{q.author}</strong>
							<span>
								{q.title} · <a href={q.source}>Källa</a>
							</span>
						</figcaption>
					</figure>
				))
			}
		</div>
	</section>

	{
		insatser.length > 0 && (
			<section class="container-wide done">
				<h2>Det vi har gjort</h2>
				<InsatsList insatser={insatser} compact />
				<p>
					<a href={url('/vad-vi-har-gjort')}>Allt vi har gjort →</a>
				</p>
			</section>
		)
	}

	<section class="container-wide split">
		<div id="evenemang">
			<h2>Kommande evenemang</h2>
			{
				upcoming.length > 0 ? (
					<EventList events={upcoming} />
				) : (
					<p>Inga planerade evenemang just nu.</p>
				)
			}
			<p><a href={url('/evenemang')}>Alla evenemang →</a></p>
		</div>
		<div>
			<h2>Blogg</h2>
			<ul class="news">
				{
					posts.map((n) => (
						<li>
							<span class="muted">
								<time datetime={n.data.date.toISOString()}>{formatDate(n.data.date)}</time> ·{' '}
								{n.data.author ?? 'PauseAI Sverige'}
							</span>
							<a href={url(`/blogg/${n.id}`)}>{n.data.title}</a>
						</li>
					))
				}
			</ul>
			<p><a href={url('/blogg')}>Alla inlägg →</a> · <a href={url('/blogg#skriv')}>Skriv för oss →</a></p>
		</div>
	</section>

	{
		stories.length > 0 && (
			<section class="container-wide stories">
				<h2>Därför engagerar vi oss</h2>
				<div class="story-grid">
					{stories.slice(0, 3).map((story) => (
						<StoryCard story={story} />
					))}
				</div>
				<p>
					<a href={url('/berattelser')}>Alla berättelser →</a> · <a href={url('/berattelser#dela')}>Dela din →</a>
				</p>
			</section>
		)
	}

	{
		contacts.length > 0 && (
			<section class="container-wide people">
				<h2>Möt oss</h2>
				<ul>
					{contacts.map((c) => (
						<li>
							{c.data.bild ? (
								<img src={imageUrl(c.data.bild)} alt="" loading="lazy" />
							) : (
								<span class="initial" aria-hidden="true">
									{c.data.namn.charAt(0)}
								</span>
							)}
							<strong>{c.data.namn}</strong>
							{c.data.roll && <span class="muted">{c.data.roll}</span>}
						</li>
					))}
				</ul>
				<p>
					Hör av dig på <a href="mailto:sweden@pauseai.info">sweden@pauseai.info</a>.
				</p>
			</section>
		)
	}

	<section class="cta" id="ga-med">
		<div class="container-wide join">
			<div>
				<h2><u>Du</u> kan hjälpa</h2>
				<p>
					För få människor är väl insatta i de potentiella riskerna med AI. Informera andra och hjälp till att stoppa
					den här kapplöpningen mot botten.
				</p>
				<p>
					Fyll i formuläret så hör vi av oss och berättar hur du kan vara med. Du bestämmer själv hur mycket tid du
					vill lägga.
				</p>
				<p><a href={url('/engagera-dig')}>Fler sätt att hjälpa till →</a></p>
			</div>
			<OnboardingEmbed />
		</div>
	</section>
</Base>

<style>
	.hero {
		padding: 4rem 0 3rem;
		background: linear-gradient(135deg, var(--brand-subtle), var(--bg) 70%);
		border-bottom: 1px solid var(--border);
	}
	.hero h1 {
		max-width: 16ch;
		font-size: clamp(2.6rem, 8vw, 5rem);
		line-height: 0.95;
	}
	.lead {
		max-width: 38rem;
		font-size: 1.2rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1.5rem;
		padding-top: 3rem;
		padding-bottom: 3rem;
	}
	.card {
		padding: 1.5rem;
		border-top: 6px solid var(--brand);
		background: var(--bg-alt);
	}
	.card h2 {
		margin-top: 0;
	}
	.card a {
		font-weight: 700;
	}
	.quotes {
		padding: 3rem 0;
		background: #111;
		color: #f2f2f2;
	}
	.quote-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 2rem;
	}
	figure {
		margin: 0;
	}
	.quotes blockquote {
		margin: 0 0 1rem;
		padding: 0;
		border: 0;
		background: none;
		font-size: 1.15rem;
	}
	figcaption strong {
		display: block;
		color: var(--brand);
		font-family: var(--font-heading);
		font-size: 1.3rem;
		text-transform: uppercase;
	}
	figcaption span {
		font-size: 0.9rem;
		color: #bbb;
	}
	.now {
		padding-bottom: 3rem;
	}
	.now h2 {
		margin-top: 0;
	}
	.timeline {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 1.5rem;
	}
	.timeline li {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding-left: 1rem;
		border-left: 4px solid var(--brand);
	}
	.timeline strong {
		font-family: var(--font-heading);
		font-size: 1.2rem;
		text-transform: uppercase;
	}
	figcaption a {
		color: inherit;
	}
	.split {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: 2rem 3rem;
		padding-top: 3rem;
	}
	.news {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.news li {
		display: flex;
		flex-direction: column;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--border);
	}
	.news a {
		font-weight: 700;
	}
	.done,
	.stories,
	.people {
		padding-top: 3rem;
	}
	.done h2,
	.stories h2,
	.people h2 {
		margin-top: 0;
	}
	.story-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1.5rem;
		margin: 1.5rem 0;
	}
	.people ul {
		list-style: none;
		margin: 1.5rem 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
		gap: 1.5rem;
	}
	.people li {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		line-height: 1.3;
	}
	.people img,
	.people .initial {
		width: 6rem;
		height: 6rem;
		margin-bottom: 0.5rem;
		border-radius: 50%;
		object-fit: cover;
	}
	.people .initial {
		display: grid;
		place-items: center;
		padding-top: 0.15em;
		line-height: 1;
		background: var(--brand);
		color: #000;
		font-family: var(--font-heading);
		font-size: 2.5rem;
		font-weight: 700;
	}
	.cta {
		margin-top: 3rem;
		padding: 3rem 0;
		background: var(--brand);
		color: #000;
	}
	.cta h2 {
		margin-top: 0;
		font-size: clamp(2rem, 6vw, 3rem);
	}
	.cta p {
		max-width: 38rem;
	}
	.cta a {
		color: #000;
		font-weight: 700;
	}
	.join {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: 1rem 3rem;
		align-items: start;
	}
	.join :global(.onboarding) {
		margin: 0;
	}
</style>
